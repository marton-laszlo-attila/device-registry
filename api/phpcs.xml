<?xml version="1.0"?>
<ruleset name="Device Registry">
    <description>PSR-12 check, independent of Pint.</description>

    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Framework-generated config files contain long env/default lines. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>config/*</exclude-pattern>
    </rule>

</ruleset>
