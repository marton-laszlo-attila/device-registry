# Variables of docker-compose.yaml. `make up` creates .env with random passwords
# if it does not exist yet; copy this file only to set the values yourself.

# MySQL passwords (the application user and root).
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host ports, both bound to 127.0.0.1 only.
APP_PORT=8080
MYSQL_PORT=3307

# Owner of the files the app container writes (your user and group id).
# UID=1000
# GID=1000
